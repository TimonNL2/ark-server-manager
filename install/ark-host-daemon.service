[Unit]
Description=Ark Host host daemon
Documentation=https://github.com/example/ark-host
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=arkhost
Group=arkhost
WorkingDirectory=/opt/ark-host
EnvironmentFile=-/etc/ark-host/ark-host.env
ExecStart=/usr/bin/node /opt/ark-host/packages/daemon/dist/index.js
Restart=on-failure
RestartSec=5
LimitNOFILE=100000
# Game servers may need extra capabilities later; keep minimal for panel MVP.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
