[Unit]
Description=Ark Host panel API
Documentation=https://github.com/example/ark-host
After=network-online.target ark-host-daemon.service
Wants=network-online.target
Requires=ark-host-daemon.service

[Service]
Type=simple
User=arkhost
Group=arkhost
WorkingDirectory=/opt/ark-host
EnvironmentFile=-/etc/ark-host/ark-host.env
ExecStart=/usr/bin/node /opt/ark-host/packages/panel/dist/index.js
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
