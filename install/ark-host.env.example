# Copied to /etc/ark-host/ark-host.env by install.sh

ARK_HOST_MOCK=1
ARK_HOST_PANEL_HOST=127.0.0.1
ARK_HOST_PANEL_PORT=3000
ARK_HOST_DAEMON_HOST=127.0.0.1
ARK_HOST_DAEMON_PORT=3920
ARK_HOST_DAEMON_URL=http://127.0.0.1:3920
ARK_HOST_DAEMON_TOKEN=CHANGE_ME_DAEMON_TOKEN
ARK_HOST_SESSION_SECRET=CHANGE_ME_SESSION_SECRET
ARK_HOST_COOKIE_SECURE=0
ARK_HOST_DATA_DIR=/var/lib/ark-host/data
ARK_HOST_DB_PATH=/var/lib/ark-host/data/ark-host.db
ARK_HOST_INSTANCES_ROOT=/var/lib/ark-host/instances
ARK_HOST_WEB_DIST=/opt/ark-host/packages/web/dist
ARK_HOST_ADMIN_USER=admin
ARK_HOST_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ARK_HOST_PROTON_PATH=/opt/ark-host/proton/current
ARK_HOST_STEAMCMD_PATH=/opt/ark-host/steamcmd/steamcmd.sh
